{
    "name": "Reversi DevContainer",
    "build": {
        "dockerfile": "Dockerfile",
        "context": ".."
    },
    "remoteUser": "developer",
    "updateRemoteUserUID": true,
    "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
    "containerEnv": {
        "UV_LINK_MODE": "copy"
    },
    "mounts": [
        // cargo
        {
            "source": "${localWorkspaceFolderBasename}-target",
            "target": "${containerWorkspaceFolder}/target",
            "type": "volume"
        },
        {
            "source": "rust-cargo-registry",
            "target": "/usr/local/cargo/registry",
            "type": "volume"
        },
        {
            "source": "rust-cargo-git",
            "target": "/usr/local/cargo/git",
            "type": "volume"
        },
        // uvのキャッシュ
        {
            "source": "uv",
            "target": "/home/developer/.cache/uv",
            "type": "volume"
        },
        {
            "source": "${localWorkspaceFolderBasename}-venv",
            "target": "${containerWorkspaceFolder}/.venv",
            "type": "volume"
        }
    ],
    "onCreateCommand": "sudo chown -R developer:developer /home/developer/.cache/uv .venv",
    "postCreateCommand": {
        "setup-ui": "cd ui && npm install",
        "setup-python": "uv sync"
    }
}